{
  "name": "simple-player",
  "version": "1.0.0",
  "description": "Lecteur Spotify minimaliste pour Windows - gros boutons, tactile, swipe",
  "main": "src/main.js",
  "author": "Julien",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  },
  "build": {
    "appId": "com.julien.simpleplayer",
    "productName": "Simple Player",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Simple Player",
      "uninstallDisplayName": "Simple Player",
      "deleteAppDataOnUninstall": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "files": [
      "src/**/*",
      "package.json"
    ]
  }
}
